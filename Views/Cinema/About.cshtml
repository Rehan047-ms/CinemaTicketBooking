@{
    ViewData["Title"] = "About Cinema";
}

<div class="container mt-4">

    <h1>About Our Cinema</h1>

    <div class="card mt-4">
        <div class="card-body">

            <h3>Cinema Booking System</h3>

            <p>
                Welcome to our Cinema Ticket Booking System.
            </p>

            <p>
                This application allows customers to book movie
                tickets and view their booking information.
            </p>

            <p>
                Customers can check movie details, show dates,
                ticket prices, booking status and total amount.
            </p>

            <a asp-action="Index"
               class="btn btn-primary">
                Back to Home
            </a>

        </div>
    </div>

</div>